# CodeLens backend environment variables.
# Copy to .env and fill in values.

# --- GitHub App (preferred) ---
# GitHub App ID (numeric). Found in App settings.
GITHUB_APP_ID=
# Path to the App's private key (.pem). Alternatively set GITHUB_PRIVATE_KEY with the PEM content.
GITHUB_PRIVATE_KEY_PATH=
# Installation ID for the target repository/org. Found in App install URL or via API.
GITHUB_INSTALLATION_ID=

# --- PAT fallback (local dev only) ---
# Personal Access Token with `repo` scope. Used only if GitHub App creds are absent.
GITHUB_TOKEN=

# --- Server ---
# CORS origin allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- PR safety caps (Phase 1) ---
# Max files to fetch in one PR (GitHub returns 30/page; we paginate up to this).
MAX_FILES_PER_PR=300

# --- Repository context caps (Phase 2) ---
# Max number of file contents to fetch from GitHub for analysis context.
MAX_FILES_TO_RETRIEVE=25
# Per-file content char cap (truncated beyond this).
MAX_FILE_CONTENT_CHARS=50000

# --- Analysis thresholds (Phase 3) ---
LARGE_PR_FILE_COUNT=20
XLARGE_PR_FILE_COUNT=50
LARGE_PR_LINE_COUNT=500
LARGE_FUNCTION_LINE_COUNT=80
HIGH_NESTING_THRESHOLD=4

# --- AI provider (Phase 4) ---
# OpenAI API key. If empty, the deterministic mock provider is used.
OPENAI_API_KEY=
# OpenAI model name.
OPENAI_MODEL=gpt-4o-mini
# Provider selection: auto | openai | gemini | mock. 'auto' uses openai if key is set, else gemini, else mock.
AI_PROVIDER=auto
# Max findings to include in the AI context payload.
AI_MAX_CONTEXT_FINDINGS=30

# --- Gemini AI provider (free tier alternative) ---
# Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini model name (use a fast flash model for lower latency)
GEMINI_MODEL=gemini-flash-lite-latest

# --- Risk engine weights (Phase 4, must sum to 100) ---
RISK_WEIGHT_CHANGE=15
RISK_WEIGHT_SCOPE=15
RISK_WEIGHT_CRITICAL=25
RISK_WEIGHT_SECURITY=20
RISK_WEIGHT_QUALITY=10
RISK_WEIGHT_TESTS=15
